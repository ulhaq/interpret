# App
APP_NAME=SaaS Boilerplate
APP_URL=http://localhost:8000
APP_ENV=local
APP_SECRET=
APP_DEBUG=true

# Organizations
ALLOW_MULTIPLE_ORGANIZATIONS=true

# Frontend proxy target (inside Docker network)
API_TARGET=http://backend:8000

# Postgres superuser password
POSTGRES_PASSWORD=

# Scoped DB users (created automatically on first container start via scripts/db-init.sh).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=db
DB_USER=dbuser
DB_PASSWORD=

# Redis carries realtime events (the app's live notification badge) between
# the worker and API processes, and holds the rate-limit counters shared by
# every API replica. Docker compose sets it; outside compose use
# redis://localhost:6379/0 (the dev stack's redis). Required outside APP_ENV=local;
# empty uses an in-process broker, which misses the worker's events, and
# per-process rate limits.
REDIS_URL=redis://localhost:6379/0

# Umami analytics (opt-in: add `analytics` to COMPOSE_PROFILES).
UMAMI_APP_SECRET=
DB_UMAMI_USER=umami_db
DB_UMAMI_PASSWORD=

# PgAdmin
PGADMIN_EMAIL=admin@example.org
PGADMIN_PASSWORD=password

# Opt-in docker compose profiles
COMPOSE_PROFILES=observability,analytics

# Auth
RATE_LIMIT_ENABLED=true
MFA_ENABLED=false
# Password sign-in lockout per email address (attempts within, and lock for, the window)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# CORS
ALLOW_ORIGINS=http://localhost:5173
ALLOW_CREDENTIALS=true

# Email
EMAIL_HOST=localhost
EMAIL_PORT=1025
# EMAIL_TIMEOUT_SECONDS=10
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TLS=false
EMAIL_FROM_ADDRESS=info@example.org
EMAIL_FROM_NAME="SaaS Boilerplate"

# Frontend
FRONTEND_URL=http://localhost:5173

# Interpret product (src/interpret/config.py)
# fake: canned text, no audio, no accounts needed (local only). live: Azure
# Speech + Claude, required in production. Use an EU Azure region.
INTERPRET_PROVIDER=fake
INTERPRET_AZURE_SPEECH_KEY=
INTERPRET_AZURE_SPEECH_REGION=swedencentral
INTERPRET_ANTHROPIC_API_KEY=
INTERPRET_ANTHROPIC_MODEL=claude-haiku-5-5

# Logging (use json with observability)
LOG_FORMAT=text
SQLALCHEMY_ECHO=false

# Observability (opt-in: add `observability` to COMPOSE_PROFILES).
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OBSERVABILITY_HOST=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_TIMEOUT_SECONDS=10
# STRIPE_MAX_NETWORK_RETRIES=2
BILLING_SUCCESS_URL="http://localhost:5173/billing/success"
BILLING_CANCEL_URL="http://localhost:5173/billing/cancel"
BILLING_PORTAL_RETURN_URL="http://localhost:5173/settings/billing"
BILLING_AUTOMATIC_TAX=true
BILLING_TRIAL_PERIOD_DAYS=7
BILLING_TRIAL_REMINDER_DELAY_DAYS=3
BILLING_TRIAL_REMINDER_INTERVAL_SECONDS=86400